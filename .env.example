# Leave both blank for explicitly labelled browser-local IndexedDB mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional MapLibre style. Defaults to OpenFreeMap Positron (no API key).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# GitHub Pages build-time public config (same Supabase project as Sites).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
